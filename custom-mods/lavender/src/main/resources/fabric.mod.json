	"authors": [
		"glisco"
	],
	"contact": {
		"repo": "https://github.com/wisp-forest/lavender",
		"homepage": "https://modrinth.com/project/lavender",
		"sources": "https://github.com/wisp-forest/lavender",
		"issues": "https://github.com/wisp-forest/lavender/issues"
	},
	"license": "MIT",
	"icon": "assets/lavender/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"io.wispforest.lavender.client.LavenderClient"
		],
