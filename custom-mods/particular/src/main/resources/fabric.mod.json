{
  "schemaVersion": 1,
  "id": "particular",
  "version": "${version}",
  "name": "Particular",
  "description": "Enhances Minecraft's ambience with hand-crafted visual effects like fireflies, falling leaves, and waterfall cascades. (Hearthwind 26.2 port)",
  "authors": [
    "Chai"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/particular/",
    "sources": "https://github.com/chailotl/particular",
    "issues": "https://github.com/chailotl/particular/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/particular/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.chailotl.particular.Main"
    ]
  },
  "mixins": [
    "particular.mixins.json"
  ],
  "accessWidener": "particular.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "owo-lib": ">=0.12.10"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/SuZb3aJUCx"
      }
    }
  }
}
