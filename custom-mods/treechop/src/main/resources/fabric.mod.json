{
   "schemaVersion": 1,
   "id": "treechop",
   "version": "${version}",
   "name": "HT's TreeChop",
   "description": "Makes trees more choppable. (Hearthwind 26.2 port)",
   "authors": [
      "hammertater"
   ],
   "license": "MIT",
   "icon": "logo.png",
   "environment": "*",
   "entrypoints": {
      "main": [
         "ht.treechop.TreeChopFabric"
      ],
      "client": [
         "ht.treechop.client.FabricClient"
      ],
      "server": [
         "ht.treechop.server.FabricServer"
      ],
      "modmenu": [
         "ht.treechop.compat.ModMenu"
      ]
   },
   "mixins": [
      "treechop.mixins.json",
      "treechop.fabric.mixins.json"
   ],
   "depends": {
      "forgeconfigapiport": ">=26.2.1",
      "fabricloader": ">=0.19.5",
      "fabric-api": "*",
      "minecraft": "~26.2",
      "java": ">=25"
   }
}
