{
  "schemaVersion": 1,
  "id": "hearthwind_client",
  "version": "${version}",
  "name": "Hearthwind: Client",
  "description": "Optional companion for Hearthwind Server - HUD bars (thirst/diet/temperature/skills/jobs), instruction toasts, water-motion preview. Presentation only; server enforces. Part of Hearthwind.",
  "authors": [
    "JMiahMan1"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.jmiahman.hearthwind.client.HearthwindClient"
    ],
  "fabric-client-gametest": [
    "dev.jmiahman.hearthwind.client.gametest.HearthwindClientGameTests",
    "dev.jmiahman.hearthwind.client.gametest.ScreensTourGameTests",
    "dev.jmiahman.hearthwind.client.gametest.DietGameTests",
    "dev.jmiahman.hearthwind.client.gametest.MiningGameTests",
    "dev.jmiahman.hearthwind.client.gametest.PackServerConnectGameTests",
    "dev.jmiahman.hearthwind.client.gametest.BiomeTempGameTests"
  ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "hearthwind_client.mixins.json"
  ],
  "icon": "assets/hearthwind/icon.png"
}