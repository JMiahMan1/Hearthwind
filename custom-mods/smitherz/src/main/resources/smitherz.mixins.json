  "package": "net.smitherz.mixin",
  "compatibilityLevel": "JAVA_25",
  "plugin": "net.smitherz.mixin.SmitherMixinPlugin",
  "mixins": [
    "ItemMixin",
    "SmithingScreenHandlerMixin",
    "GrindstoneScreenHandlerMixin",
    "LivingEntityMixin",
