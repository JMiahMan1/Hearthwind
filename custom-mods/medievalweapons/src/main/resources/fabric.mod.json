{
  "schemaVersion": 1,
  "id": "medievalweapons",
  "version": "${version}",
  "name": "Medieval Weapons",
  "description": "Old but gold weapons from the series Songs of War which is made by Plasma Studios. All credits go to Plasma Studios. Hearthwind 26.2 port of Globox_Z's Medieval Weapons (MIT).",
  "authors": [
    "Globox_Z"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/medieval-weapons",
    "sources": "https://github.com/Globox1997/MedievalWeapons",
    "issues": "https://github.com/Globox1997/MedievalWeapons/issues"
  },
  "license": "MIT",
  "icon": "assets/medievalweapons/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.medievalweapons.MedievalMain"
    ],
    "client": [
      "net.medievalweapons.MedievalClient"
    ],
    "modmenu": [
      "net.medievalweapons.config.ModMenuIntegration"
    ]
  },
