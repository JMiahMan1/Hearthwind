          "model": {
            "type": "minecraft:model",
            "model": "medievalweapons:item/long_bow_pulling_3"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "medievalweapons:item/long_bow_pulling_0"
      }
    }
