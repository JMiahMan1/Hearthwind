{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "medievalweapons:item/diamond_javelin_gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "medievalweapons:item/diamond_javelin_throwing"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "medievalweapons:item/diamond_javelin"
      }
    }
  }
}
