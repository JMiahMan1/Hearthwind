{
  "schemaVersion": 1,
  "id": "passablefoliage",
  "version": "${version}",
  "name": "Passable Foliage",
  "description": "Remove collision from leaves. Hearthwind 26.2 fork-port of Snownee's Passable Foliage (self-contained: Kiwi dependency removed).",
  "authors": [
    "Snownee"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/passable-foliage-fabric",
    "sources": "https://github.com/Snownee/PassableFoliage",
    "issues": "https://github.com/Snownee/PassableFoliage/issues"
  },
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "passablefoliage.mixins.json"
  ],
  "accessWidener": "passablefoliage.accesswidener",
  "entrypoints": {
    "main": [
      "snownee.passablefoliage.PassableFoliageInit"
    ],
    "fabric-gametest": [
      "snownee.passablefoliage.PassableFoliageGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
