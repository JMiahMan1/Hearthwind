    "issues": "https://github.com/ExpensiveKoala/Fishing-Real/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "koala.fishingreal.FishingRealFabric"
    ]
  },
  "mixins": [
    "fishingreal.fabric.mixins.json"
  ],
  "accessWidener": "fishingreal.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
